# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings > API). Both are safe to expose to the browser —
# access control is enforced by Postgres row-level security
# (see supabase/migrations/0001_init.sql), not by keeping these secret.
#
# Until both are set, the app runs fully as an anonymous, localStorage-only
# experience — see lib/supabase/config.ts's hasSupabaseConfig().

NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works too
# (it's the name the Vercel integration may sync).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Turn Run/Submit on once a judge worker is running (judge/src/worker.ts).
# Off by default so submissions never queue with nobody to judge them.
JUDGE_ENABLED=

# Optional bot protection for sign-up/sign-in/password reset: a Cloudflare
# Turnstile site key. Enable Turnstile with its secret key in Supabase too
# (Authentication > Bot and Abuse Protection), or sign-ins will fail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
